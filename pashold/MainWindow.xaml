<Window x:Class="pashold.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:pashold.ViewModels"
        Title="Менеджер Pashold" Height="500" Width="1200">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" MinWidth="200"/>
            <ColumnDefinition Width="80*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="JSON файлы:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox Grid.Row="1" FontSize="16" 
                     ItemsSource="{Binding JsonFiles}" 
                     SelectedItem="{Binding SelectedJsonFile}" 
                     DisplayMemberPath="OriginalName"/>
            <Button Grid.Row="2"
                    Command="{Binding BrowseFolderCommand}"
                    Margin="0,5,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <TextBlock TextAlignment="Center">
                    <Run Text="🔍" FontSize="14"/>
                    <Run Text=" Обзор" FontSize="14"/>
                </TextBlock>
            </Button>
            <Button Grid.Row="3"
                    Command="{Binding CreateProgramFileCommand}"
                    Margin="0,5,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <TextBlock TextAlignment="Center">
                    <Run Text="➕" FontSize="14"/>
                    <Run Text=" Создать" FontSize="14"/>
                </TextBlock>
            </Button>
        </Grid>

        <!-- Правая панель -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка всегда сверху -->

            <Grid>
                <Button Grid.Row="0"
                x:Name="btn_AddBlock"
                Content="Добавить блок"
                FontSize="14"
                IsEnabled="{Binding IsFileSelected}"
                Width="120"
                Margin="10"
                Command="{Binding AddBlockCommand}" />

                <Button
                x:Name="btn_ShowPassword"
                Content="Раскрывать пароль"
                FontSize="14"
                IsEnabled="{Binding IsFileSelected}"
                Margin="0,10,10,10" Click="btn_ShowPassword_Click" HorizontalAlignment="Right" Width="143" />
            </Grid>

            <!-- Прокручиваемая область -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="10" Padding="5">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontWeight="Bold" FontSize="16" 
                                                 Margin="0,0,5,0"
                                                 VerticalContentAlignment="Center"
                                                 MaxHeight="100"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>

                                        <TextBox Grid.Column="1" 
                                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontStyle="Italic" FontSize="14" 
                                                 Margin="0,0,5,0"
                                                 VerticalContentAlignment="Center"
                                                 MaxHeight="100"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>

                                        <Button Grid.Column="2" 
                                                Width="120" Margin="0,0,5,0"
                                                Command="{Binding DataContext.AddPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="➕" FontSize="14"/>
                                                <Run Text=" ПАРОЛЬ" FontSize="12"/>
                                            </TextBlock>
                                        </Button>

                                        <Button Grid.Column="3" 
                                                Width="120" Margin="0,0,200,0"
                                                Command="{Binding DataContext.DeleteBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="―" FontSize="16"/>
                                                <Run Text="" FontSize="16"/>
                                            </TextBlock>
                                        </Button>
                                        <ProgressBar Grid.Column="3" Margin="0,0,200,0"
Value="50"
Maximum="100"
HorizontalAlignment="Stretch"
VerticalAlignment="Stretch"
Opacity="0.5"
IsHitTestVisible="False"/>
                                    </Grid>

                                    <!-- PasswordItems -->
                                    <ItemsControl ItemsSource="{Binding PasswordItems}" Margin="20,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0" 
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                             MinWidth="200" Margin="0,0,5,0" VerticalContentAlignment="Center"
                                                             PreviewMouseDoubleClick="PasswordBox_PreviewMouseDoubleClick" MouseLeave="PasswordBox_MouseLeave"/>

                                                    <TextBox Grid.Column="1" 
                                                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                                                             MinWidth="300" Margin="0,0,5,0" VerticalContentAlignment="Center"
                                                             IsReadOnly="True" 
                                                             PreviewMouseDoubleClick="PasswordBox_PreviewMouseDoubleClick" 
                                                             MouseLeave="PasswordBox_MouseLeave"/>

                                                    <Button Grid.Column="2" 
                                                            Content="⧉" Width="120" Margin="0,0,5,0" FontSize="16"
                                                            Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Grid.Column="3" 
                                                            Content="―" Width="120" Margin="0,0,5,0" FontSize="16"
                                                            Command="{Binding DataContext.DeletePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                    </Button>
                                                    <ProgressBar Grid.Column="3" Margin="0,0,5,0"
             Value="50"
             Maximum="100"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Opacity="0.5"
             IsHitTestVisible="False"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
    
    