<Window x:Class="pashold.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:pashold.ViewModels"
        Title="Менеджер Pashold" Height="500" Width="1200">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Левая панель -->
        <Grid DockPanel.Dock="Left" Width="250" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="JSON файлы:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox Grid.Row="1" 
             ItemsSource="{Binding JsonFiles}" 
             SelectedItem="{Binding SelectedJsonFile}" 
             DisplayMemberPath="OriginalName"/>
            <Button Grid.Row="2" Content="Обзор" Command="{Binding BrowseFolderCommand}" Margin="0,5,0,0"/>
            <Button Grid.Row="3" Content="+Создать" Command="{Binding CreateProgramFileCommand}" Margin="0,5,0,0"/>
        </Grid>

        <!-- Правая панель -->
        <ScrollViewer>
            <StackPanel Margin="10">
                <Button Content="Добавить блок" Width="120" Margin="0,0,0,10"
                Command="{Binding AddBlockCommand}" />

                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="10" Padding="5">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                         FontWeight="Bold" FontSize="14" 
                                         MinWidth="200" Margin="0,0,5,0"/>

                                        <TextBox Grid.Column="1" 
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                         FontStyle="Italic" 
                                         MinWidth="400" Margin="0,0,5,0"/>

                                        <Button Grid.Column="2" 
                                        Content="Удалить блок" Width="120" Margin="0,0,5,0"
                                        Command="{Binding DataContext.DeleteBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>

                                        <Button Grid.Column="3" 
                                        Content="Добавить пароль" Width="120" Margin="0,0,200,0"
                                        Command="{Binding DataContext.AddPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                    </Grid>

                                    <!-- PasswordItems -->
                                    <ItemsControl ItemsSource="{Binding PasswordItems}" Margin="20,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0" 
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                     MinWidth="200" Margin="0,0,5,0"/>

                                                    <TextBox Grid.Column="1" 
                                                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                                                     MinWidth="300" Margin="0,0,5,0"
                                                     IsReadOnly="True"
                                                     PreviewMouseDoubleClick="PasswordBox_PreviewMouseDoubleClick" 
                                                     MouseLeave="PasswordBox_MouseLeave"/>

                                                    <Button Grid.Column="2" 
                                                    Content="Удалить" Width="80" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.DeletePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                                    <Button Grid.Column="3" 
                                                    Content="Копировать" Width="80" 
                                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>