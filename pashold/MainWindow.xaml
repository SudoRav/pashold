<Window x:Class="pashold.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:pashold.ViewModels"
       Title="Менеджер Pashold" Height="560" Width="1220" MinHeight="480" MinWidth="900" Background="{StaticResource DiscordDarkBrush}">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" MinWidth="200"/>
            <ColumnDefinition Width="80*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0" Margin="0,0,12,0" Padding="14" Background="{StaticResource DiscordDarkerBrush}" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="JSON файлы:" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                <ListBox Grid.Row="1" FontSize="12" 
                     ItemsSource="{Binding JsonFiles}" 
                     SelectedItem="{Binding SelectedJsonFile}" 
                     DisplayMemberPath="OriginalName"/>
                <Button Grid.Row="2"
                    Command="{Binding BrowseFolderCommand}"
                    Margin="0,5,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <TextBlock TextAlignment="Center" MinHeight="20">
                    <Run Text="🔍" FontSize="14"/>
                    <Run Text=" Обзор" FontSize="12"/>
                    </TextBlock>
                </Button>
                <Button Grid.Row="3"
                    Command="{Binding CreateProgramFileCommand}"
                    Margin="0,5,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <TextBlock TextAlignment="Center" MinHeight="20">
                    <Run Text="➕" FontSize="14"/>
                    <Run Text=" Создать" FontSize="12"/>
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Правая панель -->
        <Grid Grid.Column="1" Background="{StaticResource DiscordDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка всегда сверху -->

            <Border Margin="0,0,0,12" Padding="14" Background="{StaticResource DiscordDarkerBrush}" CornerRadius="12">
                <StackPanel Orientation="Horizontal">
                    <Button
                x:Name="btn_AddBlock"
                Content="Добавить блок"
                FontSize="12"
                IsEnabled="{Binding IsFileSelected}"
                Width="160"
                Margin="0,0,10,0"
                Command="{Binding AddBlockCommand}" HorizontalAlignment="Left" />

                    <Button
                x:Name="btn_ShowPassword"
                Content="■ Скрывать пароль"
                FontSize="12"
                IsEnabled="{Binding IsFileSelected}"
                Margin="0" Click="btn_ShowPassword_Click" HorizontalAlignment="Left" Width="160" />
                </StackPanel>
            </Border>

            <!-- Прокручиваемая область -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource DiscordBorderBrush}" BorderThickness="1" Margin="0,0,0,12" Padding="12" Background="{StaticResource DiscordDarkerBrush}" CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontWeight="Bold" FontSize="14" 
                                                 Margin="0,0,5,0"
                                                 VerticalContentAlignment="Center"
                                                 MaxHeight="100"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>

                                        <TextBox Grid.Column="1" 
                                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontStyle="Italic" FontSize="12" 
                                                 Margin="0,0,5,0"
                                                 VerticalContentAlignment="Center"
                                                 MaxHeight="100"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>

                                        <Button Grid.Column="2" 
        Width="120" Margin="0,0,5,0"
        Command="{Binding DataContext.MultiCopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding}">
                                            <TextBlock TextAlignment="Center">
 <Run Text="⧉⧉⧉" FontSize="16"/>
        <Run Text="" FontSize="12"/>
                                            </TextBlock>
                                        </Button>

                                        <Button Grid.Column="3" 
                                                Width="120" Margin="0,0,5,0"
                                                Command="{Binding DataContext.AddPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="➕" FontSize="14"/>
                                                <Run Text="" FontSize="12"/>
                                            </TextBlock>
                                        </Button>

                                        <Button Grid.Column="4" 
                                                Style="{StaticResource DangerButtonStyle}"
                                                Width="120" Margin="0,0,50,0"
                                                Command="{Binding DataContext.DeleteBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                FontWeight="Bold"
                                                PreviewMouseLeftButtonDown="DeleteBlockButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="DeleteButton_PreviewMouseLeftButtonUp"
                                                MouseLeave="DeleteButton_MouseLeave">
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="―" FontSize="14"/>
                                                <Run Text="" FontSize="12"/>
                                            </TextBlock>
                                        </Button>
                                        <ProgressBar Grid.Column="4" Margin="0,0,50,0"
Value="0"
Maximum="100"
HorizontalAlignment="Stretch"
VerticalAlignment="Stretch"
Opacity="0.5"
IsHitTestVisible="False"/>
                                    </Grid>

                                    <!-- PasswordItems -->
                                    <ItemsControl ItemsSource="{Binding PasswordItems}" Margin="20,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0" 
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                             MinWidth="200" Margin="0,0,5,0" VerticalContentAlignment="Center"
                                                             PreviewMouseDown="TextBox_PreviewMouseDown"
                                                             PreviewMouseDoubleClick="PasswordBox_PreviewMouseDoubleClick" 
                                                             MouseLeave="PasswordBox_MouseLeave"/>

                                                    <TextBox Grid.Column="1" 
                                                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                                                             MinWidth="300" Margin="0,0,5,0" VerticalContentAlignment="Center"
                                                             IsReadOnly="True" 
                                                             PreviewMouseDown="TextBox_PreviewMouseDown"
                                                             PreviewMouseDoubleClick="PasswordBox_PreviewMouseDoubleClick" 
                                                             MouseLeave="PasswordBox_MouseLeave"/>

                                                    <Button Grid.Column="2" 
        Width="45" Margin="0,0,5,0"
        Command="{Binding DataContext.MovePasswordUp, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding}">
                                                        <TextBlock TextAlignment="Center">
        <Run Text="▲" FontSize="14"/>
        <Run Text="" FontSize="12"/>
                                                        </TextBlock>
                                                    </Button>

                                                    <Button Grid.Column="3" 
Width="45" Margin="0,0,5,0"
Command="{Binding DataContext.MovePasswordDown, RelativeSource={RelativeSource AncestorType=Window}}"
CommandParameter="{Binding}">
                                                        <TextBlock TextAlignment="Center">
<Run Text="▼" FontSize="14"/>
<Run Text="" FontSize="12"/>
                                                        </TextBlock>
                                                    </Button>

                                                    <Button Grid.Column="4" 
                                                            Content="⧉" Width="90" Margin="0,0,5,0" FontSize="16"
                                                            Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Grid.Column="5" 
                                                             Style="{StaticResource DangerButtonStyle}"
                                                            Content="―" Width="120" Margin="0,0,5,0" FontSize="16"
                                                            Command="{Binding DataContext.DeletePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontWeight="Bold"
                                                            PreviewMouseLeftButtonDown="DeletePasswordButton_PreviewMouseLeftButtonDown"
                                                            PreviewMouseLeftButtonUp="DeleteButton_PreviewMouseLeftButtonUp"
                                                            MouseLeave="DeleteButton_MouseLeave">
                                                    </Button>
                                                    <ProgressBar Grid.Column="5" Margin="0,0,5,0"
             Value="0"
             Maximum="100"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Opacity="0.5"
             IsHitTestVisible="False"/>

                                                    <Border Name="brd_reaction" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource DiscordGreenBrush}" Margin="0,0,5,0" IsHitTestVisible="False" Opacity="0">
                                                        <TextBlock Text="✔" FontSize="18" TextAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
    
    