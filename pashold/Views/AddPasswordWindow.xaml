<Window x:Class="pashold.AddPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить пароль" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown"
        Background="{StaticResource DiscordDarkBrush}">
    <Border Margin="16" Padding="18" Background="{StaticResource DiscordDarkerBrush}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource DiscordMutedTextBrush}"/>
            <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Пароль:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource DiscordMutedTextBrush}"/>
            <TextBox x:Name="ContentTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Длина:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource DiscordMutedTextBrush}"/>

            <TextBox x:Name="LenghtTextBox" Text="40" Grid.Row="2" Grid.Column="1" Margin="5,5,100,5"/>
            <Button Content="Gen" Grid.Row="2" Grid.Column="1" Margin="0,5,5,5" Click="Generate_Click" HorizontalAlignment="Right" Width="86"/>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Добавить" Width="100" Margin="5" Click="Add_Click"/>
                <Button Content="Отмена" Width="90" Margin="5" Click="Cancel_Click" Background="{StaticResource DiscordElevatedBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>