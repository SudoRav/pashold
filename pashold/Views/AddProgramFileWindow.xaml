<Window x:Class="pashold.AddProgramFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать файл" Height="200" Width="300">
    <StackPanel Margin="10">
        <TextBlock Text="Название файла:"/>
        <TextBox x:Name="tbName" Margin="0,5,0,10"/>
        <TextBlock Text="Ключ шифрования:"/>
        <PasswordBox x:Name="tbKey" Margin="0,5,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Создать" Width="80" Margin="5" Click="Create_Click"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>