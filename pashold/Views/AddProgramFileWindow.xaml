<Window x:Class="pashold.AddProgramFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать файл" Height="320" Width="360" KeyDown="Window_KeyDown"
        Background="{StaticResource DiscordDarkBrush}">
    <Border Margin="16" Padding="18" Background="{StaticResource DiscordDarkerBrush}" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Название файла:" Foreground="{StaticResource DiscordMutedTextBrush}"/>
            <TextBox x:Name="tbName" Margin="0,8,0,12"/>
            <TextBlock Text="Ключ шифрования:" Foreground="{StaticResource DiscordMutedTextBrush}"/>
            <PasswordBox x:Name="tbKey" Margin="0,8,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Создать" Width="95" Margin="5" Click="Create_Click"/>
                <Button Content="Отмена" Width="90" Margin="5" Click="Cancel_Click" Background="{StaticResource DiscordElevatedBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>