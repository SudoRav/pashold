<Window x:Class="pashold.Views.AskKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Введите ключ" Height="240" Width="360" KeyDown="Window_KeyDown"
        Background="{StaticResource DiscordDarkBrush}">
    <Border Margin="16" Padding="18" Background="{StaticResource DiscordDarkerBrush}" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Введите ключ шифрования:" Foreground="{StaticResource DiscordMutedTextBrush}"/>
            <PasswordBox x:Name="tbKey" Margin="0,8,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" Margin="5" Click="Ok_Click"/>
                <Button Content="Отмена" Width="90" Margin="5" Click="Cancel_Click" Background="{StaticResource DiscordElevatedBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>