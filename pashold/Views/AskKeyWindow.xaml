<Window x:Class="pashold.Views.AskKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введите ключ" Height="150" Width="300" KeyDown="Window_KeyDown">
    <StackPanel Margin="10">
        <TextBlock Text="Введите ключ шифрования:"/>
        <PasswordBox x:Name="tbKey" Margin="0,5,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Margin="5" Click="Ok_Click"/>
            <Button Content="Отмена" Width="70" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>